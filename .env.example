# Database Configuration
DATABASE_URL=postgresql://username:password@localhost:5432/purrfect_paws

# Security: use a long random value and keep it private
SECRET_KEY=replace-with-a-long-random-secret
FLASK_DEBUG=0
SESSION_COOKIE_SECURE=0  # Set to 1 behind HTTPS in deployment

# API Keys
CAT_API_KEY=your-cat-api-key-here  # Get your API key from https://thecatapi.com/
DOG_API_KEY=your-dog-api-key-here
